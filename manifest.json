{
  "manifest_version": 3,
  "name": "SEO/GEO Frog",
  "version": "4.4.1",
  "description": "Local SEO, GEO, page-speed and JavaScript diagnostics with evidence-based Claude fix prompts.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "SEO/GEO Frog \u00b7 Audit this page",
    "default_icon": {
      "16": "icons/frog-16.png",
      "32": "icons/frog-32.png"
    }
  },
  "short_name": "SEO/GEO Frog",
  "icons": {
    "16": "icons/frog-16.png",
    "32": "icons/frog-32.png",
    "48": "icons/frog-48.png",
    "128": "icons/frog-128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
